{
  "name": "osolot",
  "version": "1.0.0",
  "private": true,
  "description": "osolot helps people pool their resources.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "worker:dev": "npm run dev -w osolot-api",
    "worker:deploy": "npm run deploy -w osolot-api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:make-migration": "supabase db diff --local -f",
    "db:migrate": "supabase migration up --local",
    "db:types": "supabase gen types --local > workers/osolot-api/supabase-types/generated-types.d.ts",
    "db:update": "npm run db:migrate && npm run db:types",
    "android:dev": "npm run android:dev -w mobile",
    "android": "npm run android -w mobile",
    "web": "npm run web -w mobile",
    "ios": "npm run ios -w mobile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magmadude20/osolot.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "supabase": "^2.98.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "dependencies": {
  },
  "overrides": {
    "@supabase/supabase-js": "2.105.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
